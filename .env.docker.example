# Copia como `.env.docker.local` en el servidor. Este archivo de ejemplo se
# versiona; `.env.docker.local` queda ignorado por Git.

SERVER_ENV_FILE=.env.docker.local

# Deben coincidir con el usuario, base y contraseña del contenedor existente.
POSTGRES_USER=soloweed
POSTGRES_PASSWORD=
POSTGRES_DB=soloweed

# Entre contenedores se usa el DNS de Compose y el puerto interno 5432.
# La contraseña dentro de esta URL debe estar codificada para URL.
DATABASE_URL=postgresql://soloweed:<password-url-encoded>@db:5432/soloweed
EXPECTED_DATABASE_HOST=db
APP_IMAGE=soloweed-soloweed

# URL canónica pública. NEXT_PUBLIC_SITE_URL se incorpora también durante build.
NEXT_PUBLIC_SITE_URL=https://soloweed.store

# Horas máximas desde la última oferta vista antes de que /api/health responda 503.
# CATALOG_FRESHNESS_HOURS=72

# Opcional: analítica de visitas/clics con Umami. Se activa solo con ambos valores.
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Contacto comercial que aparece en los informes B2B compartibles.
# NEXT_PUBLIC_CONTACT_EMAIL=contacto@ejemplo.cl
# NEXT_PUBLIC_CONTACT_WHATSAPP=569XXXXXXXX

APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8093
POSTGRES_BIND_ADDRESS=192.168.100.2
POSTGRES_HOST_PORT=5435

# Usa exactamente la imagen y el volumen que ya utiliza soloweed-db. Confírmalos
# con `docker inspect` antes de recrear el servicio; no apuntes a un volumen nuevo.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_VOLUME_NAME=soloweed_soloweed_data

# Volumen persistente para los reportes internos regenerables.
# CATALOG_AUDIT_VOLUME_NAME=soloweed-catalog-audit

# Opcional: habilita la demo simulada dentro del contenedor con un token largo,
# aleatorio y no compartido públicamente. Déjalo sin definir para deshabilitarla.
# PRICING_DEMO_TOKEN=<long-random-token>
