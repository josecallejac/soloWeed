[Unit]
Description=SoloWeed healthcheck publico
After=network-online.target
Wants=network-online.target
ConditionPathExists=__SOLOWEED_PROJECT_DIR__/.env

[Service]
Type=oneshot
WorkingDirectory=__SOLOWEED_PROJECT_DIR__
ExecStart=/bin/bash __SOLOWEED_PROJECT_DIR__/scripts/ops/check-health.sh
TimeoutStartSec=1min
