{
  "name": "soloweed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/validate-build-env.mjs",
    "build": "next build --webpack",
    "env:check": "node scripts/validate-runtime-env.mjs",
    "prestart": "node scripts/validate-runtime-env.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/run-tests.mjs",
    "test:integration": "node scripts/run-tests.mjs --integration",
    "scrape": "tsx scripts/scrape.ts",
    "catalog:weekly": "tsx scripts/weekly-catalog.ts",
    "prices:refresh": "tsx scripts/refresh-product-prices.ts",
    "match:auto": "tsx scripts/auto-match-offers.ts",
    "match:image": "tsx scripts/match-by-image.ts",
    "match:embedding": "tsx scripts/match-by-embedding.ts",
    "catalog:curate": "tsx scripts/curate-comparable-products.ts",
    "catalog:expand": "tsx scripts/expand-curated-product-offers.ts",
    "catalog:growth:validate": "tsx scripts/validate-reviewed-catalog-growth.ts",
    "catalog:audit:export": "tsx scripts/export-catalog-audit.ts",
    "ops:reports": "node scripts/ops/check-reports-hygiene.mjs",
    "ops:performance": "node scripts/ops/check-public-performance.mjs",
    "catalog:six-store": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local --import tsx scripts/diagnose-six-store-potential.ts",
    "catalog:short-desc": "tsx scripts/generate-short-descriptions.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "brand:backfill": "tsx scripts/backfill-brand-keys.ts",
    "model:backfill": "tsx scripts/backfill-model-keys.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install --with-deps"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sharp": "0.35.3",
    "tsx": "^4.23.12"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "deepmerge-ts": "8.0.2",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "undici": "6.28.0",
    "onnxruntime-node": "1.29.0",
    "postcss": "8.5.26",
    "protobufjs": "7.6.5",
    "sharp": "0.35.3",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "next": {
      "postcss": "8.5.26"
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
