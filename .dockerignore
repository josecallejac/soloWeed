.git
.github
node_modules

# .next se genera en el host por deploy.sh y es el artefacto que empaqueta
# Dockerfile; no excluirlo del contexto. Cache y artefactos de desarrollo no
# participan en `next start` y solo inflan el contexto.
.next/cache
.next/dev

# Ninguna credencial local debe entrar al contexto o a las capas de imagen.
.env
.env.*

# Artefactos grandes, datos vivos y resultados regenerables.
backups
backups_nuevo
backups*.zip
playwright-report
test-results
reports
scratch
prisma/*.db*

# Configuración local de agentes y editores.
.agents
.antigravitycli
.claude
.tmp-appdata
.tmp-userprofile
*.tsbuildinfo
npm-debug.log*
