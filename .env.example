# Desarrollo desde el notebook/host. Copia este archivo como
# `.env.development.local` y reemplaza la contraseña; no edites ni subas esta
# plantilla con credenciales reales.
DATABASE_URL="postgresql://soloweed:<password-url-encoded>@192.168.100.2:5435/soloweed"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Horas máximas desde la última oferta vista antes de marcar el catálogo obsoleto.
# CATALOG_FRESHNESS_HOURS=192
# SCRAPE_STORE_CONCURRENCY=3
# SCRAPE_SAVE_BATCH_SIZE=100

# Opcional: analítica de visitas/clics con Umami. Se activa solo con ambos valores.
# NEXT_PUBLIC_UMAMI_SRC="https://cloud.umami.is/script.js"
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# Alertas operativas opcionales por Telegram. Nunca guardes el token en Git.
# SOLOWEED_TELEGRAM_BOT_TOKEN=""
# SOLOWEED_TELEGRAM_CHAT_ID=""

# Contacto comercial que aparece en los informes B2B compartibles.
# NEXT_PUBLIC_CONTACT_EMAIL="contacto@ejemplo.cl"
# NEXT_PUBLIC_CONTACT_WHATSAPP="569XXXXXXXX"

# Opcional en desarrollo. En Docker productivo usa un valor largo y aleatorio.
# PRICING_DEMO_TOKEN="friendlygrow-preview"
