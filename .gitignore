# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
test_output.txt
test_matching.db

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: nunca versionar credenciales; solo las plantillas seguras.
.env*
!.env.example
!.env.docker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local database
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-shm
/prisma/*.db-wal

# database backups
/backups/*.db
/backups/*.json
/backups/*.json.gz
/backups_nuevo/
/backups*.zip

# temporary DB files and dumps
/prisma/*.before-docs
/prisma/*.checkpoint
/prisma/*.current-backup
/prisma/*.temp-round3
/prisma/recover.sql

# reports runs and scratch directory
/reports/catalog-audit/runs/
/scratch/

reports/upgrades-run.txt

# estado transitorio del flujo frugal: se regenera en cada scrape
# (un snapshot viejo commiteado daria deltas engañosos)
/reports/scrape-snapshot.json
/reports/catalog-audit/triage-*-candidates.csv
/reports/catalog-audit/triage-*-orphan-orphan.csv
/reports/catalog-audit/triage-orphan-groups-*.csv
# raw diagnostic logs (match/prices/diagnose runs) — MB artifacts, keep out of git
/reports/catalog-audit/*.log
# idem para los logs crudos que quedan en reports/ (diagnose-orphan-pairs imprime cada
# par por consola: el de r60 pesaba 481 KB). El CSV que sale del log si se commitea.
/reports/*-log.txt
/reports/store-coverage-*.csv
# barridos por imagen: miles de filas regenerables, 1 producto util de cada 3.400
/reports/fg-imgup-nivel*.csv

# previews de inspeccion visual de la marca (se regeneran con generate-icons.ts)
/assets/brand/preview-*.png

# Scaffolding de frameworks multi-agente (teamwork/antigravity) — no versionar
/.agents/
/.claude/settings.local.json
/PROJECT.md
/ORIGINAL_REQUEST.md
/TEST_READY.md
/build_*.log
