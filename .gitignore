# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
test_output.txt
test_matching.db

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local database
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-shm
/prisma/*.db-wal

# database backups
/backups/*.db
/backups/*.json
/backups/*.json.gz

# temporary DB files and dumps
/prisma/*.before-docs
/prisma/*.checkpoint
/prisma/*.current-backup
/prisma/*.temp-round3
/prisma/recover.sql

# reports runs and scratch directory
/reports/catalog-audit/runs/
/scratch/

reports/upgrades-run.txt

# estado transitorio del flujo frugal: se regenera en cada scrape
# (un snapshot viejo commiteado daria deltas engañosos)
/reports/scrape-snapshot.json
/reports/catalog-audit/triage-*-candidates.csv
/reports/catalog-audit/triage-*-orphan-orphan.csv
/reports/catalog-audit/triage-orphan-groups-*.csv
